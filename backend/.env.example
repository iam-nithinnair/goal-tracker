# Copy to .env. Never commit .env.
# Local stack: `npx supabase status -o env`.  Hosted project: see docs/07-hosted-supabase-setup.md
# (hosted projects use asymmetric keys: leave SUPABASE_JWT_SECRET empty).
ENVIRONMENT=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects that sign tokens with a shared HS256 secret; leave empty for asymmetric keys (JWKS).
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_ANON_KEY=
